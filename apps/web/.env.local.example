NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Free language models for the copilot, tried in the order of
# apps/web/lib/ai-models.json; one without a key is skipped. Leave the *_MODEL
# variables unset unless overriding: the defaults live in ai-models.json.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
MISTRAL_API_KEY=
MISTRAL_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-3-5-haiku-latest
TTS_API_URL=
TTS_API_KEY=
RENDER_WORKER_URL=http://localhost:8080
RENDER_WORKER_TOKEN=
# Render backend: http (default, RENDER_WORKER_URL) or cloud-run-job.
RENDER_BACKEND=
GCP_PROJECT_ID=
GCP_REGION=
CLOUD_RUN_JOB=
GCP_SA_KEY_B64=
# Assistant voice via Google Cloud Text-to-Speech (reuses GCP_SA_KEY_B64; the
# service account needs the Text-to-Speech API enabled). Example voice:
# es-US-Chirp3-HD-Achernar. Rate 0.25-2.0, default 1.0. Empty = HeyGen or the
# browser voice.
GOOGLE_TTS_VOICE=
GOOGLE_TTS_RATE=
DEMO_USER_PASSWORD=
ADMIN_PASSWORD=

# Sentry (optional). Without SENTRY_DSN nothing is reported.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only for readable browser stack traces (source map upload at build time).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ElevenLabs - voz del asistente (/api/speak), primera opcion antes de Google y HeyGen.
# Sin ELEVENLABS_API_KEY se omite. Voz por defecto cgSgspJ2msm6clMCkdW9 (Jessica);
# modelo por defecto eleven_flash_v2_5.
ELEVENLABS_API_KEY=
ELEVENLABS_ASSISTANT_VOICE_ID=
ELEVENLABS_ASSISTANT_MODEL=