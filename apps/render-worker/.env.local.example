PORT=8080
FFMPEG_PATH=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RENDERS_BUCKET=renders
# Shared secret the /render endpoint requires as `Authorization: Bearer <value>`.
# Left unset here on purpose: unset means /render fails open (see index.ts),
# which is what keeps `npm run dev` working with no setup. Set a real value
# in Railway before this worker is reachable from outside the team.
RENDER_WORKER_TOKEN=

# Sentry (optional). Without it failed renders are only logged.
SENTRY_DSN=

# ElevenLabs narration (optional, needs a paid plan). Without both, Piper narrates.
# Key: npm run set:ai-key -- elevenlabs   Voice: npm run elevenlabs:voces
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
